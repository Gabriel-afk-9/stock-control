generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // Valores aceitos: 'ADMIN', 'ALMOXARIFE', 'REQUISITOR'
  createdAt DateTime @default(now())

  @@map("users")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  quantity  Int
  price     Decimal
  minStock  Int      @default(10)
  maxStock  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}